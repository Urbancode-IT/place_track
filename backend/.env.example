PORT=5001
NODE_ENV=development

# PostgreSQL — app uses DATABASE_URL only (required)
# Local:
DATABASE_URL=postgresql://postgres:password@localhost:5432/place_track
# Render / Neon / Supabase: paste the full URL from the provider dashboard (often port 5432 + ?sslmode=require)
# DATABASE_SSL=true
# Do NOT point Render at a home/VPS IP unless PostgreSQL listens publicly and firewall allows Render outbound IPs.

JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Required for trainer / student emails.
# Best: Google Workspace mailbox = From address (SPF/DKIM on urbancode.in).
#   SMTP_USER=admin@urbancode.in
#   SMTP_PASS=<App Password for admin@urbancode.in>
#   SMTP_FROM=PlaceTrack <admin@urbancode.in>
# Alt: SMTP_USER=some@gmail.com + Gmail “Send mail as” for admin@urbancode.in, then SMTP_FROM=PlaceTrack <admin@urbancode.in>
# After start, GET /health → mail.verified true, mail.from shows the real From.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@urbancode.in
SMTP_PASS=your_app_password
SMTP_FROM=PlaceTrack <admin@urbancode.in>

# Firebase Admin (pick ONE)
# Option A: absolute path to service account JSON on the server (Linux), e.g. /home/zen/keys/firebase.json
# Leave unset if you are not using FCM push yet.
# FIREBASE_SERVICE_ACCOUNT_PATH=
# Option B: JSON string (single line)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local: Vite dev server. Production: your real site URL (no trailing slash).
FRONTEND_URL=http://localhost:5173
# Browsers send Origin — must list every frontend URL (comma-separated). Merged with FRONTEND_URL in code.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://placetrack.urbancode.in
# Optional override for Google Chat / email “View more” links (never use localhost).
# PUBLIC_FRONTEND_URL=https://placetrack.urbancode.in

# Production example (custom domain + Render API) — set BOTH on Render:
# FRONTEND_URL=https://placetrack.urbancode.in
# CORS_ORIGIN=https://placetrack.urbancode.in
# Add https://www.placetrack.urbancode.in too if you use www.

# Interview start = calendar day from interview.date + timeSlot text; default India IST
INTERVIEW_SCHEDULE_OFFSET=+05:30
INTERVIEW_SCHEDULE_TZ=Asia/Kolkata

# --- Google Chat (daily “today + tomorrow” board to the space) ---
# 1) Chat space → Apps & integrations → Incoming webhooks → paste full URL here
GOOGLE_CHAT_WEBHOOK_URL=
# Public API base for Chat Approve/Reject buttons (no trailing slash). Defaults to api.placetrack.urbancode.in
# PUBLIC_API_URL=https://api.placetrack.urbancode.in
# Optional HMAC secret for Chat action tokens (falls back to JWT_SECRET)
# GOOGLE_CHAT_ACTION_SECRET=
# 2) Local test: npm run chat:ping   |   Full board: npm run chat:board
# 3) Default board time: 08:00 GOOGLE_CHAT_CRON_TZ (override with GOOGLE_CHAT_BOARD_CRON).
# 4) Best on Render: omit GOOGLE_CHAT_DISABLE_INTERNAL_CRON (Render sets RENDER=true → external-only by default).
#    Set GOOGLE_CHAT_CRON_SECRET, then cron-job.org GET at the same clock time, e.g. 08:00 Asia/Kolkata:
#    https://YOUR-RENDER.onrender.com/api/public/cron/google-chat-board?secret=YOUR_SECRET
#    Always-on dyno + in-process only: set GOOGLE_CHAT_DISABLE_INTERNAL_CRON=false
#    Local / VPS: keep false or omit RENDER — in-process cron runs on the server.
# 5) If external-only but CRON_SECRET is missing, the app falls back to in-process cron (still misses while Render sleeps).
# 6) Same digest also emailed when the job runs — comma-separated. If empty, all ADMIN users with email get it.
DAILY_BOARD_EMAIL_TO=
# Interview create/update → immediate Google Chat: all (default) | today | off
GOOGLE_CHAT_IMMEDIATE_NOTIFY=today
GOOGLE_CHAT_BOARD_CRON=0 8 * * *
GOOGLE_CHAT_CRON_TZ=Asia/Kolkata
GOOGLE_CHAT_DISABLE_INTERNAL_CRON=false
GOOGLE_CHAT_CRON_SECRET=
# How many minutes ± around “30 min before” the cron accepts (runs every minute)
TRAINER_REMINDER_WINDOW_MIN=5
# Set to false to turn off 30-minute trainer emails
TRAINER_REMINDER_ENABLED=true
# Student finish-outcome link: ONLY after the time slot ends (never during / before)
# If slot has no end time (e.g. "10:00 AM"), assume this many minutes duration
INTERVIEW_DEFAULT_DURATION_MIN=60
# Extra minutes after slot end before mailing
STUDENT_FINISH_LINK_AFTER_END_MIN=5
# Still send once if server was down, up to this many hours after end
STUDENT_FINISH_LINK_CATCHUP_HOURS=8
# Set to false to turn off automatic student finish-link emails
STUDENT_FINISH_LINK_ENABLED=true
# If student has not submitted finish form, remind once after this many hours
STUDENT_FINISH_REMINDER_HOURS=2
STUDENT_FINISH_REMINDER_CATCHUP_HOURS=24
STUDENT_FINISH_REMINDER_ENABLED=true
