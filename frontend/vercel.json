{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.placetrack.urbancode.in/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.placetrack.urbancode.in/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
